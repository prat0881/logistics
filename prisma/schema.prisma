// ─────────────────────────────────────────────────────────────────────────────
// DATABASE OBJECTS THAT EXIST ONLY IN RAW SQL — READ BEFORE RUNNING MIGRATIONS
//
// Prisma's schema language cannot express a partial (WHERE-clause) unique index or a CHECK
// constraint, so the four objects below live only in hand-written migration SQL and have no
// counterpart in any model here. `prisma migrate dev` diffs this file against a shadow database
// built by replaying the migrations: it will see four objects the models do not declare and
// PROPOSE DROPPING THEM. Never accept that. Review every generated migration for `DROP INDEX` /
// `DROP CONSTRAINT` on these names, delete those statements, and re-run.
//
//   CREATE UNIQUE INDEX "ClientContact_one_primary"
//     ON "ClientContact" ("clientId") WHERE "pocLevel" = 'PRIMARY';
//     → prisma/migrations/20260826092000_client_address_and_contacts/migration.sql
//   CREATE UNIQUE INDEX "FreightForwarderContact_one_primary"
//     ON "FreightForwarderContact" ("freightForwarderId") WHERE "pocLevel" = 'PRIMARY';
//     → prisma/migrations/20260826093000_ff_contacts_and_terms/migration.sql
//   CREATE UNIQUE INDEX "WarehouseContact_one_primary"
//     ON "WarehouseContact" ("warehouseId") WHERE "pocLevel" = 'PRIMARY';
//     → prisma/migrations/20260826094000_warehouse_master/migration.sql
//   ALTER TABLE "Warehouse" ADD CONSTRAINT "Warehouse_single_owner"
//     CHECK ("freightForwarderId" IS NULL OR "clientId" IS NULL);
//     → prisma/migrations/20260826100000_warehouse_single_owner_check/migration.sql
//
// These are not cosmetic. The three `*_one_primary` indexes ARE the "at most one primary
// contact" invariant: ClientsService/FreightForwardersService/WarehousesService each catch the
// resulting P2002 and map it to a 409 ("This client already has a primary contact", and its two
// siblings). Drop the index and those services stop being able to detect the condition at all —
// the write just succeeds and the record silently grows a second primary. `Warehouse_single_owner`
// is likewise the sole enforcement of one-owner-per-warehouse under concurrency; both
// ClientsService.setWarehouses and FreightForwardersService.setWarehouses catch its violation
// via `mapOwnershipRace`.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EXECUTIVE
  MANAGER
  ADMINISTRATOR
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EXECUTIVE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum PocLevel {
  PRIMARY
  SECONDARY
  NONE
}

enum FreightMode {
  ROAD
  AIR
  SEA
}

model Client {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String?         @db.Uuid
  clientCode    String          @unique
  companyName   String          @unique
  industry      String?
  country       String
  streetAddress String
  city          String
  postalCode    String?
  status        MasterStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdById   String?
  updatedById   String?
  contacts      ClientContact[]
  queries       Query[]
  warehouses    Warehouse[]

  @@index([tenantId])
}

model ClientContact {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String?      @db.Uuid
  clientId          String       @db.Uuid
  client            Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  designation       String?
  email             String
  contactNo         String
  whatsappAvailable Boolean      @default(false)
  wechatAvailable   Boolean      @default(false)
  botimAvailable    Boolean      @default(false)
  pocLevel          PocLevel     @default(NONE)
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?
  updatedById       String?

  @@index([clientId])
}

model Vessel {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String?      @db.Uuid
  vesselCode   String       @unique
  name         String
  imoNumber    String   @unique
  shippingLine String
  vesselType   String
  status       MasterStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String?
  updatedById  String?
  queries      Query[]

  @@index([tenantId])
}

model FreightForwarder {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String?       @db.Uuid
  freightForwarderCode String        @unique
  companyName          String        @unique
  companyAddress       String
  city                 String
  postalCode           String?
  country              String
  pic                  String
  contactNumber        String
  email                String
  availableCountries   String[]
  modes                FreightMode[]
  handleDg             Boolean       @default(false)
  vatTrnEori           String?
  whLocation           String?
  defaultCurrency      String?
  paymentTerms         PaymentTerm?
  typicalLeadTime      Int?
  status               MasterStatus  @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdById          String?
  updatedById          String?

  rfqs       Rfq[]
  quotes     Quote[]
  contacts   FreightForwarderContact[]
  warehouses Warehouse[]

  @@index([tenantId])
}

enum PaymentTerm {
  CREDIT_7
  CREDIT_15
  CREDIT_30
  CREDIT_45
  CREDIT_60
  ADVANCE_100
  ADVANCE_50_BALANCE_50
  ADVANCE_30_BALANCE_70
  ADVANCE_70_BALANCE_30
  AFTER_DELIVERY_100
}

model FreightForwarderContact {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String?  @db.Uuid
  freightForwarderId String   @db.Uuid
  freightForwarder   FreightForwarder @relation(fields: [freightForwarderId], references: [id], onDelete: Cascade)
  name               String
  designation        String?
  email              String
  contactNo          String
  whatsappAvailable  Boolean  @default(false)
  wechatAvailable    Boolean  @default(false)
  botimAvailable     Boolean  @default(false)
  pocLevel           PocLevel @default(NONE)
  status             MasterStatus @default(ACTIVE)
  createdById        String?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([freightForwarderId])
}

model Rfq {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String?          @db.Uuid
  queryId            String           @db.Uuid
  query              Query            @relation(fields: [queryId], references: [id], onDelete: Cascade)
  freightForwarderId String           @db.Uuid
  freightForwarder   FreightForwarder @relation(fields: [freightForwarderId], references: [id], onDelete: Restrict)
  rfqNumber          String           @unique
  accessTokenHash    String           @unique
  /// The raw portal token. Persisted (S5.9 D8) so a re-quote email can render the CURRENT link
  /// without minting a new one — rotation would break the forwarder's bookmark (D7). Nullable
  /// for rows created before S5.9. `accessTokenHash` remains the lookup index.
  accessToken        String?
  submissionDeadline DateTime
  incoterms          Incoterms?
  currency           String?
  quoteValidityUntil DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  quotes        Quote[]
  tokenReissues RfqTokenReissue[]

  @@unique([queryId, freightForwarderId])
  @@index([queryId])
  @@index([freightForwarderId])
  @@index([tenantId])
}

// Audit trail for RFQ access-token rotations (one row per re-issue). The initial
// mint is implicit in Rfq.createdAt; these record each subsequent rotation + actor.
model RfqTokenReissue {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  rfqId     String   @db.Uuid
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([rfqId])
  @@index([tenantId])
}

model Quote {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String?          @db.Uuid
  queryId            String           @db.Uuid
  query              Query            @relation(fields: [queryId], references: [id], onDelete: Cascade)
  legId              String           @db.Uuid
  leg                Leg              @relation(fields: [legId], references: [id], onDelete: Cascade)
  freightForwarderId String           @db.Uuid
  freightForwarder   FreightForwarder @relation(fields: [freightForwarderId], references: [id], onDelete: Restrict)
  rfqId              String?          @db.Uuid
  rfq                Rfq?             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  status             QuoteStatus      @default(SELECT)
  manifestSnapshot   Json?
  chargeConfigSnapshot Json?
  submittedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  totalChargeableWeightT Decimal? @db.Decimal(12, 3)
  grandTotal             Decimal? @db.Decimal(14, 2)
  dgSurchargeNote        String?
  termsConditions        String?
  // S5.9.6 (register A6) — the two columns are DIFFERENT things and must never be conflated:
  //   draftJson     — the forwarder's SCRATCHPAD. `FfPortalService.saveDraft` overwrites it
  //                   verbatim at any writable status (RFQ_SENT/REQUOTED), with no version hash
  //                   and no provenance. A half-typed revision lives here.
  //   submittedJson — the OFFER. Written by `FfPortalService.submit` alone, from the same
  //                   re-derived/validated/materialized draft it writes to draftJson, so the two
  //                   agree at submit time and diverge only when the forwarder types afterwards.
  // Both are cleared together when a quote re-enters distribution (RfqService.distribute) — but
  // that pairing is NOT a general invariant the code enforces: change-order.strategy.ts's
  // re-freeze deliberately clears `draftJson` alone. Safe there, and only there, because that
  // updateMany is scoped to the RFQ_SENT ("refreshing") quotes, and an RFQ_SENT quote's
  // `submittedJson` is already NULL — submit never leaves a row at that status, and the one edge
  // back to it clears both columns. Anyone adding a third clearing site owns re-deriving that.
  draftJson              Json?
  submittedJson          Json?

  // v3 (FF Portal per-variant quoting): leg-level chargeable weight (was per-QuoteCargoLine) + notes.
  chargedWeightKg Decimal? @db.Decimal(12, 3)
  notes           String?

  quoteCargoLines       QuoteCargoLine[]
  chargeLines           ChargeLine[]
  truckingCharges       TruckingCharge[]
  seaFreightRates       SeaFreightRate[]
  warehouseStagingLines WarehouseStagingLine[]
  transitPlans          TransitPlan[]

  @@unique([legId, freightForwarderId])
  @@index([queryId])
  @@index([legId])
  @@index([freightForwarderId])
  @@index([rfqId])
  @@index([tenantId])
}

model RfqSequence {
  queryId    String @id @db.Uuid
  lastNumber Int    @default(0)
}

model QuoteCargoLine {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  quoteId   String   @db.Uuid
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  packageId String   @db.Uuid
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quoteId, packageId])
  @@index([quoteId])
  @@index([tenantId])
}

model ChargeLine {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String?    @db.Uuid
  quoteId   String     @db.Uuid
  quote     Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  zone      ChargeZone?
  label     String
  isPreset  Boolean    @default(false)
  presetKey String?
  amount    Decimal    @db.Decimal(14, 2)
  note      String?
  sortOrder Int        @default(0)
  definitionKey String?
  pieceWeightKg    Decimal?          @db.Decimal(12, 3)
  airlineLimitKg   Decimal?          @db.Decimal(12, 3)
  ratePerExcessKg  Decimal?          @db.Decimal(14, 2)
  billOfLadingType BillOfLadingType?
  // v3 (FF Portal per-variant quoting): the matrix column this charge belongs to.
  // NULL = Air's single implicit column (or a non-variant line); DEDICATED/GROUPAGE/FCL/LCL
  // for Road/Sea. Mirrors TruckingCharge/SeaFreightRate/TransitPlan.rateVariant.
  rateVariant ChargeRateVariant?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([quoteId])
  @@index([tenantId])
}

model TruckingCharge {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String?           @db.Uuid
  quoteId            String            @db.Uuid
  quote              Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  legEndpointPointId String            @db.Uuid
  legEndpointPoint   Point             @relation(fields: [legEndpointPointId], references: [id], onDelete: Restrict)
  truckingType       TruckingType
  basis              TruckingBasis
  amount             Decimal           @db.Decimal(14, 2)
  remarks            String?
  definitionKey      String?
  rateVariant        ChargeRateVariant @default(DEDICATED)
  tonnage            TruckTonnage?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([quoteId])
  @@index([tenantId])
}

model SeaFreightRate {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String?           @db.Uuid
  quoteId       String            @db.Uuid
  quote         Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rateVariant   ChargeRateVariant // FCL | LCL
  containerSize ContainerSize?    // FCL only
  amount        Decimal           @db.Decimal(14, 2)
  remarks       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([quoteId])
  @@index([tenantId])
}

model WarehouseStagingLine {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String?           @db.Uuid
  quoteId               String            @db.Uuid
  quote                 Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  warehousePointId      String            @db.Uuid
  warehousePoint        Point             @relation(fields: [warehousePointId], references: [id], onDelete: Restrict)
  position              WarehousePosition
  label                 String
  isPreset              Boolean           @default(false)
  amount                Decimal           @db.Decimal(14, 2)
  note                  String?
  cargoAcceptanceWindow String?
  definitionKey         String?
  cfsCode               String?
  side                  WarehouseSide?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([quoteId])
  @@index([tenantId])
}

model ChargeLineDefinition {
  id           String              @id @default(uuid()) @db.Uuid
  key          String              @unique
  mode         FreightMode
  role         ChargeLineRole
  inputType    ChargeLineInputType @default(PLAIN)
  zone         ChargeZone?
  tagKey       String?
  label        String
  sortOrder    Int                 @default(0)
  isActive     Boolean             @default(true)
  category     ChargeCategory?
  variant      ChargeVariant       @default(BOTH)
  isAdditional Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdById  String?
  updatedById  String?

  selections LegChargeLineSelection[]

  @@index([mode, role, isActive])
}

model LegChargeLineSelection {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String?              @db.Uuid
  legId        String               @db.Uuid
  leg          Leg                  @relation(fields: [legId], references: [id], onDelete: Cascade)
  definitionId String               @db.Uuid
  definition   ChargeLineDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())

  @@unique([legId, definitionId])
  @@index([legId])
}

model TransitPlan {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String?  @db.Uuid
  quoteId               String   @db.Uuid
  quote                 Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // v3 (FF Portal per-variant quoting): one TransitPlan row per priced variant (was one per quote).
  // NULL = Air's single implicit column; DEDICATED/GROUPAGE/FCL/LCL for Road/Sea. The non-days
  // schedule fields below repeat per row (each variant's row is self-contained).
  rateVariant           ChargeRateVariant?
  carrier               String?
  flightVoyageNo        String?
  departureDate         DateTime?
  arrivalDate           DateTime?
  carrierSurcharge      Decimal? @db.Decimal(14, 2)
  guaranteedTransitDays Int?
  plannedPickupDate     DateTime?
  airline               String?
  flightNumber          String?
  plannedDeparture      DateTime?
  plannedArrival        DateTime?
  shippingLine          String?
  vesselVoyage          String?
  etd                   DateTime?
  eta                   DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([quoteId, rateVariant])
  @@index([quoteId])
  @@index([tenantId])
}

model FreightDensityFactor {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String?     @db.Uuid
  mode      FreightMode @unique
  kgPerCbm  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model ChecklistDefinition {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @db.Uuid
  itemKey       String   @unique
  label         String
  order         Int
  dgConditional Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CodeSequence {
  key        String @id
  lastNumber Int    @default(0)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model StatusTransition {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String?  @db.Uuid
  seq      Int      @unique @default(autoincrement())
  entity   String
  entityId String
  from     String?
  to       String
  event    String
  reason   String?
  actorId  String?  @db.Uuid
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([tenantId])
}

model ChangeLog {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String?  @db.Uuid
  queryId           String   @db.Uuid
  query             Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  entity            String
  entityId          String   @db.Uuid
  changeType        String
  actorId           String?  @db.Uuid
  at                DateTime @default(now())
  auditRefId        String?  @db.Uuid
  approvalRequestId String?  @db.Uuid
  payload           Json

  @@index([queryId])
  @@index([entity, entityId])
}

enum AwardDecisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model LegAwardDecision {
  id                 String              @id @default(uuid()) @db.Uuid
  legId              String              @unique @db.Uuid
  leg                Leg                 @relation(fields: [legId], references: [id], onDelete: Cascade)
  queryId            String              @db.Uuid
  query              Query               @relation(fields: [queryId], references: [id], onDelete: Cascade)
  shortlistedQuoteId String?             @db.Uuid
  shortlistedVariant ChargeRateVariant?
  recommendedQuoteId String?             @db.Uuid
  recommendedVariant ChargeRateVariant?
  overrideReason     String?
  status             AwardDecisionStatus @default(DRAFT)
  sentForApprovalAt  DateTime?
  sentByUserId       String?             @db.Uuid
  decidedByUserId    String?             @db.Uuid
  decidedAt          DateTime?
  rejectionReason    String?
  updatedAt          DateTime            @updatedAt

  @@index([queryId])
}

model AwardDecisionEvent {
  id      String             @id @default(uuid()) @db.Uuid
  legId   String             @db.Uuid
  leg     Leg                @relation(fields: [legId], references: [id], onDelete: Cascade)
  queryId String             @db.Uuid
  query   Query              @relation(fields: [queryId], references: [id], onDelete: Cascade)
  type    String
  quoteId String?            @db.Uuid
  variant ChargeRateVariant?
  reason  String?
  actorId String?            @db.Uuid
  at      DateTime           @default(now())

  @@index([legId])
  @@index([queryId])
}

enum QueryStatus {
  DRAFT
  CREATED
  RFQ_READY
  RFQ_SENT
  QUOTED
  AWAITING_CLIENT_DECISION
  WON
  LOST
  CLOSED
  NO_RESPONSE
  QUOTING_CLIENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Incoterms {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
  NA
}

enum ReferenceTag {
  HEAVY
  FRAGILE
  NON_STACKABLE
  OUT_OF_GAUGE
  DG
}

enum DimUnit {
  CM
  MM
}

enum WeightUnit {
  KG
  TONNE
  GM
}

enum PackageType {
  BOX
  PALLET
  CRATE
  CARTON
  DRUM
  BUNDLE
}

enum UnitOfMeasure {
  PC
  SET
  BOX
  KG
  M
  ROLL
}

enum FileKind {
  MSDS
}

enum PointType {
  PICKUP
  DELIVERY
  WAREHOUSE
  AIRPORT
  SEAPORT
}

enum LegStatus {
  DRAFT
  READY_FOR_RFQ
  RFQ_SENT
  PARTIALLY_QUOTED
  FULLY_QUOTED
  PENDING_APPROVAL
  AWARDED
  IN_TRANSIT
  DELIVERED
  CLOSED
  APPROVED
}

enum QuoteStatus {
  SELECT
  RFQ_SENT
  QUOTED
  EXPIRED
  INVALID
  REQUOTED
  PENDING_APPROVAL
  CLOSED
  APPROVED
}

enum ChargeZone {
  ORIGIN
  MAIN_FREIGHT
  DESTINATION
}

enum ChargeLineRole {
  CORE
  STANDARD
  TAG_DRIVEN
  WAREHOUSE
}

enum ChargeLineInputType {
  PLAIN
  TRUCKING
  WAREHOUSE_STAGING
  HEAVY_WEIGHT_CALC
}

enum ChargeCategory {
  ORIGIN
  FREIGHT
  DESTINATION
  ADDITIONAL
}

enum ChargeVariant {
  DEDICATED
  GROUPAGE
  DIRECT
  INDIRECT
  FCL
  LCL
  BOTH
}

enum ChargeRateVariant {
