# Neon pooled connection (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon direct connection (migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
PORT=4000

# --- Local dev alternative (docker-compose.dev.yml) ---
# DATABASE_URL="postgresql://svyft:svyft@localhost:5432/svyft?schema=public"
# DIRECT_URL="postgresql://svyft:svyft@localhost:5432/svyft?schema=public"

# Auth / JWT
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS="7"
# MUST be false on plain HTTP — browsers drop Secure cookies over HTTP. Set true only under HTTPS.
COOKIE_SECURE="false"
BCRYPT_COST="10"

# Seed accounts (dev defaults shown; override in every real environment)
SEED_ADMIN_EMAIL="admin@svyft.local"
SEED_ADMIN_PASSWORD="admin-dev-password"
SEED_MANAGER_EMAIL="manager@svyft.local"
SEED_MANAGER_PASSWORD="manager-dev-password"
SEED_EXECUTIVE_EMAIL="exec@svyft.local"
SEED_EXECUTIVE_PASSWORD="exec-dev-password"
